{
  "name": "codex-usage-card",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:visual": "vite --host 127.0.0.1 --port 4173 --config vite.visual.config.ts",
    "check:bundle": "npm run build && git diff --exit-code -- ../custom_components/codex_usage/frontend/codex-usage-card.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
