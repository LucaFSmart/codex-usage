{
  "name": "codex-usage-card",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:visual": "vite --host 127.0.0.1 --port 4173 --config vite.visual.config.ts",
    "check:bundle": "npm run build && git diff --exit-code -- ../custom_components/codex_usage/frontend/codex-usage-card.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "happy-dom": "20.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
